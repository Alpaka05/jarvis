# ─── Jarvis Konfiguration ─────────────────────────────────────────────────────
# Kopiere diese Datei nach .env und trage deine Werte ein.

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Haupt-Provider: anthropic | openai | gemini | ollama
LLM_PROVIDER=anthropic
# Fallback, wenn der Haupt-Provider nicht konfiguriert oder nicht erreichbar ist
# (leer lassen, um keinen Fallback zu nutzen)
LLM_FALLBACK_PROVIDER=ollama
# Denk-Aufwand für Claude: low | medium | high | xhigh | max (medium = schnelle Antworten)
LLM_EFFORT=medium

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Kostenloses Kontingent gilt pro Modell (~5 Anfragen/Minute). Bei Erschöpfung rotiert Jarvis auf diese Modelle:
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Lokales Modell via Ollama (vorher: `ollama pull llama3.1:8b`)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── Persönliches ────────────────────────────────────────────────────────────
USER_NAME=
# Anrede am Anfang jeder Antwort, z.B. Sir (leer = keine)
SALUTATION=

# ─── Home Assistant ──────────────────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# ─── E-Mail (IMAP & SMTP) ────────────────────────────────────────────────────
EMAIL_ACCOUNT=
EMAIL_PASSWORD=
IMAP_SERVER=
IMAP_PORT=993
SMTP_SERVER=
SMTP_PORT=587

# ─── Spotify (Web API, läuft auf Windows und Mac; benötigt Spotify Premium) ──
# App anlegen unter https://developer.spotify.com/dashboard, Redirect-URI eintragen.
# Ohne diese Werte nutzt Jarvis auf dem Mac AppleScript als Fallback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Bevorzugtes Wiedergabegerät (Namensteil, z.B. "Echo"); leer = dieser Rechner. Per Sprache überstimmbar ("auf dem TV").
SPOTIFY_DEVICE_NAME=

# ─── Sprache ─────────────────────────────────────────────────────────────────
TTS_ENABLED=true
# edge = neuronale Microsoft-Edge-Stimmen (online, sehr natürlich, Windows+Mac gleich)
# system = Betriebssystem-Stimme (offline; Windows SAPI / macOS say)
TTS_ENGINE=edge
# Männliche deutsche Edge-Stimmen: de-DE-ConradNeural (tief, ruhig), de-DE-KillianNeural,
# de-DE-FlorianMultilingualNeural (spricht auch englische Begriffe sauber), de-AT-JonasNeural
# Britischer "Jarvis": en-GB-RyanNeural (dann LANGUAGE=en-GB setzen)
EDGE_VOICE=de-DE-ConradNeural
# Feintuning: Tempo z.B. -5% / +10%, Tonhöhe z.B. -10Hz (tiefer) / +5Hz
EDGE_RATE=+0%
EDGE_PITCH=-5Hz
# Systemstimme für TTS_ENGINE=system bzw. als Offline-Fallback (leer = automatisch nach LANGUAGE)
VOICE_NAME=
# Sprache für Sprachausgabe und -erkennung
LANGUAGE=de-DE

# ─── Sprachmodus (Wake-Word) ─────────────────────────────────────────────────
# true = Jarvis startet direkt im Lausch-Modus und reagiert auf "Hey Jarvis"
VOICE_MODE_ON_START=false
# openWakeWord-Modell (vortrainiert: hey_jarvis) und Empfindlichkeit 0–1 (niedriger = empfindlicher)
WAKE_WORD_MODEL=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
# Sekunden nach einer Antwort, in denen du ohne Wake-Word weiterfragen kannst (0 = aus)
FOLLOW_UP_SECONDS=6
# Lautstärke-Schwelle, ab der anhaltendes Reinreden die Sprachausgabe unterbricht (höher = unempfindlicher, 0 = aus).
# Unabhängig davon unterbricht "Hey Jarvis" immer, und "Stopp" oder "Danke" beenden eine Antwort.
BARGE_IN_THRESHOLD=0.06
# Bestätigung nach dem Wake-Word: chime (Ton), voice (gesprochen, z.B. "Ja?"), both
ACK_STYLE=both
ACK_PHRASE=Ja?
# Sprechpause in Sekunden, die eine Frage beendet (höher = mehr Zeit zum Nachdenken mitten im Satz)
SILENCE_LIMIT_SECONDS=1.4
# Silero-VAD-Schwelle 0–1: ab wann ein Audioblock als Sprache gilt (niedriger = empfindlicher)
VAD_THRESHOLD=0.5

# ─── Websuche ────────────────────────────────────────────────────────────────
# Optional: Tavily-API-Key (https://app.tavily.com, kostenloses Kontingent) für bessere,
# LLM-optimierte Suchergebnisse. Ohne Key nutzt Jarvis die kostenlose ddgs-Metasuche.
TAVILY_API_KEY=
