# Jarvis Configuration File

# LLM API Settings (OpenAI, Gemini, Ollama, Anthropic)
LLM_PROVIDER=openai  # options: openai, gemini, ollama
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_HOST=http://localhost:11434

# Home Assistant Integration
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_home_assistant_long_lived_token

# Email Integration (IMAP & SMTP)
EMAIL_ACCOUNT=your_email@example.com
EMAIL_PASSWORD=your_app_password
IMAP_SERVER=imap.example.com
IMAP_PORT=993
SMTP_SERVER=smtp.example.com
SMTP_PORT=587

# Calendar Settings
CALENDAR_TYPE=local  # options: local, caldav, google
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json

# Voice Output
TTS_ENABLED=true
VOICE_NAME=de_DE  # macOS say voice name (e.g., Anna, Markus, Viktoria)
