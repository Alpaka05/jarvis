{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["svelte", "vite/client"]
  },
  "include": ["ui/src/**/*.ts", "ui/src/**/*.js", "ui/src/**/*.svelte"]
}
